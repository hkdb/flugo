flugo_version: {{.FlugoVersion}}

app:
  id: {{.AppID}}
  name: {{.AppName}}
  version: "0.1.0"
  description: "A Flugo application"
  author: ""
  license: ""
  url: ""
  # url_scheme registers the app as the <scheme>:// deep-link handler on all
  # platforms (run `flugo deeplink` after changing on an existing project).
  # url_scheme: myapp
  window:
    width: 1280
    height: 720
    min_width: 360
    min_height: 480
    titlebar_style: default

backend:
  module: {{.Module}}
  services:
    - service.go

platforms:
  linux:
    flatpak:
      runtime: org.freedesktop.Platform
      runtime_version: "24.08"
      sdk: org.freedesktop.Sdk
      permissions: []
  macos:
    bundle_id: {{.AppID}}
    minimum_version: "13.0"
  windows:
    publisher: ""
  android:
    min_sdk: 24
    target_sdk: 35
  ios:
    minimum_version: "16.0"

icons:
  source: assets/icons/icon.svg
